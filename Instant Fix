local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 8)
ButtonCorner.Parent = ToggleButton

local originalDurations = {}
local isEnabled = false

ToggleButton.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    if isEnabled then
        StatusLabel.Text = "ON"
        StatusLabel.TextColor3 = Color3.fromRGB(90, 255, 120)
        StatusFrame.BackgroundColor3 = Color3.fromRGB(20, 50, 30)
        ToggleButton.Text = "ปิดใช้งาน"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 205, 90)
        
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                if originalDurations[v] == nil then
                    originalDurations[v] = v.HoldDuration
                end
                v.HoldDuration = 0
            end
        end
    else
        StatusLabel.Text = "OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        StatusFrame.BackgroundColor3 = Color3.fromRGB(50, 30, 30)
        ToggleButton.Text = "เปิดใช้งาน"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(230, 60, 60)
        
        for v, duration in pairs(originalDurations) do
            if v and v.Parent then
                v.HoldDuration = duration
            end
        end
    end
end)
