        end
    end

    -- เมื่อพิมพ์เปลี่ยนชื่อแล้วกดคลิกออก (FocusLost) ให้เซฟทันที
    nameBox.FocusLost:Connect(function()
        savedData[index].name = nameBox.Text
        saveToFile()
    end)

    -- กดปุ่มบันทึกตำแหน่ง
    saveBtn.MouseButton1Click:Connect(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            savedData[index].cframe = char.HumanoidRootPart.CFrame
            tpBtn.BackgroundColor3 = Color3.fromRGB(220, 140, 50)
            tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            countLabel.Text = "สถานะ: ปลอดภัย (0 คน)"
            countLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            saveToFile()
        end
    end)

    -- กดปุ่มมุดดิน (ตรึงพิกัด + ลงไป 9 เมตรใต้จุดที่เซฟ)
    tpBtn.MouseButton1Click:Connect(function()
        if savedData[index].cframe then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                activeTargetCFrame = savedData[index].cframe
                local rootPart = char.HumanoidRootPart
                
                rootPart.Anchored = true
                rootPart.CFrame = savedData[index].cframe - Vector3.new(0, 9, 0)
                UnderPanel.Visible = true
            end
        end
    end)
end

for i = 1, 5 do
