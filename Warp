-- ลูปสแกนเรดาร์เช็กจำนวนคนรอบจุดทั้ง 10 ช่องแบบเรียลไทม์
RunService.RenderStepped:Connect(function()
    for index, data in pairs(savedData) do
        if data.cframe then
            local targetPos = data.cframe.Position
            local peopleNearby = 0
            
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    local char = p.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - targetPos).Magnitude
                        if dist <= 20 then
                            peopleNearby = peopleNearby + 1
                        end
                    end
                end
            end
            
            if peopleNearby == 0 then
                data.countLabel.Text = "สถานะ: ปลอดภัย (0 คน)"
                data.countLabel.TextColor3 = Color3.fromRGB(90, 245, 110)
            else
                data.countLabel.Text = "⚠️ มีคนใกล้ๆ: " .. peopleNearby .. " คน!"
                data.countLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
            end
        end
    end
end)
