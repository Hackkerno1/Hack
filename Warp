        name = "จุดที่ " .. index,
        countLabel = countLabel,
        tpBtn = tpBtn
    }

    -- โหลดข้อมูลที่เคยเซฟไว้ในไฟล์คอมพิวเตอร์
    local slotKey = tostring(index)
    if loadedData[slotKey] then
        if loadedData[slotKey].name then
            savedData[index].name = loadedData[slotKey].name
            nameBox.Text = loadedData[slotKey].name
        end
        if loadedData[slotKey].cf then
            savedData[index].cframe = CFrame.new(unpack(loadedData[slotKey].cf))
            tpBtn.BackgroundColor3 = Color3.fromRGB(220, 140, 50)
            tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            countLabel.Text = "สถานะ: ปลอดภัย (0 คน)"
