-- ปุ่มกดปลดล็อกและโผล่ขึ้นสู่ผิวดิน
SurfaceBtn.MouseButton1Click:Connect(function()
    if activeTargetCFrame then
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local rootPart = char.HumanoidRootPart
            rootPart.Anchored = false
            rootPart.CFrame = activeTargetCFrame
            UnderPanel.Visible = false
        end
    end
end)

-- ลูปเช็กจำนวนคนรอบจุดแบบเรียลไทม์
RunService.RenderStepped:Connect(function()
    for index, data in pairs(savedData) do
        if data.cframe then
            local targetPos = data.cframe.Position
            local peopleNearby = 0
            
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    local char = p.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - targetPos).Magnitude
                        if dist <= 20 then
                            peopleNearby = peopleNearby + 1
                        end
                    end
                end
            end
            
            if peopleNearby == 0 then
                data.countLabel.Text = "สถานะ: ปลอดภัย (0 คน)"
                data.countLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                data.countLabel.Text = "⚠️ มีคนใกล้ๆ: " .. peopleNearby .. " คน!"
                data.countLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end
    end
end)
